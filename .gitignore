yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

## Package manager files
.pnp/
.pnp.js

## Build outputs
dist/
build/
.cache/

## Test coverage
coverage/

## Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

## Editor directories and IDE files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

## OS generated files
.DS_Store
Thumbs.db
desktop.ini

## OneDrive temporary files
~$*

